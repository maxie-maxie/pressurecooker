# Normalize line endings to LF in the repository and working tree.
* text=auto eol=lf

# Text source
*.go    text eol=lf
go.mod  text eol=lf
go.sum  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
LICENSE text eol=lf

# Binary and generated media should never be line-ending converted
*.png  binary
*.jpg  binary
*.mp4  binary
*.mkv  binary
*.webm binary
*.exe  binary
*.dll  binary
